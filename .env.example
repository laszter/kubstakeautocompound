# =====================================================================================
# KUB Stake Auto-Compound — ไฟล์ตั้งค่า (คัดลอกเป็น .env ก่อนใช้งาน)
#
#   cp .env.example .env
#   bash scripts/gen-secrets.sh      # เติมค่าลับที่ว่างอยู่ให้อัตโนมัติ (รันซ้ำได้ ไม่เขียนทับค่าเดิม)
#   docker compose up -d --build
#
# - ค่าที่ "จำเป็น" (required) ปล่อยว่างไว้ในไฟล์นี้ — ถ้ายังว่าง docker compose จะหยุดพร้อมข้อความแจ้ง
# - ห้าม commit ไฟล์ .env (มีค่าลับ) — .gitignore กันไว้แล้ว
# - ค่าว่าง (VAR=) = ใช้ค่า default (ยกเว้น SUBGRAPH_URL ที่ค่าว่าง = ปิด)
# - ถ้าค่ามีอักขระ $ หรือ # หรือช่องว่าง ให้ครอบด้วย single quote เช่น VAR='a$b#c'
# =====================================================================================

# ---------- ฐานข้อมูล PostgreSQL (service db; ไม่เปิด port ออกนอกเครื่อง) ----------
# ชื่อผู้ใช้ฐานข้อมูล (compose ประกอบเป็น DATABASE_URL ให้ migrate/web/worker เอง)
POSTGRES_USER=kubstake
# ชื่อฐานข้อมูล
POSTGRES_DB=kubstake
# [จำเป็น] รหัสผ่านฐานข้อมูล — ใช้เฉพาะ a-z 0-9 (อยู่ใน URL) สร้างด้วย: openssl rand -hex 24
# ตั้งได้ครั้งเดียวตอนสร้าง volume pgdata ครั้งแรก — เปลี่ยนภายหลังต้องเปลี่ยนใน Postgres ด้วย (ALTER USER)
POSTGRES_PASSWORD=

# ---------- ค่าลับของแอป ----------
# [จำเป็น] กุญแจเข้ารหัส private key (AES-256-GCM) = base64 ของ 32 bytes สร้างด้วย: openssl rand -base64 32
# ⚠️ สำรองค่านี้แยกจาก backup ฐานข้อมูล — ถ้าหาย private key ที่เก็บไว้จะกู้คืนไม่ได้, ห้ามเปลี่ยนหลังเพิ่ม wallet แล้ว
MASTER_KEY=
# [จำเป็น] กุญแจเข้ารหัส session cookie (อย่างน้อย 32 ตัวอักษร) สร้างด้วย: openssl rand -base64 48
SESSION_SECRET=
# รหัสผ่านเข้าหน้าเว็บไม่ได้อยู่ในไฟล์นี้: ตั้งที่หน้าเว็บตอนเข้าครั้งแรก และเปลี่ยนภายหลังได้ที่หน้า settings

# ---------- เว็บ (service web) ----------
# IP ที่ bind port บนเครื่อง host — 127.0.0.1 = เข้าได้จากเครื่องนี้เท่านั้น (แนะนำ)
# เปลี่ยนเป็น 0.0.0.0 เฉพาะเมื่ออยู่หลัง reverse proxy ที่มี TLS (ดู docs/operations.md)
WEB_BIND=127.0.0.1
# port บนเครื่อง host ที่เปิดหน้าเว็บ (http://127.0.0.1:3000) — เปลี่ยนได้ถ้า 3000 ถูกใช้อยู่
WEB_PORT=3000
# true = cookie ส่งเฉพาะ HTTPS (ตั้ง true เมื่อเข้าผ่าน https/reverse proxy), false = ใช้กับ http://127.0.0.1
COOKIE_SECURE=false
# อายุ session หลัง login (วินาที) ค่าเริ่มต้น 43200 = 12 ชั่วโมง
SESSION_TTL_SEC=43200
# Block explorer สำหรับลิงก์ tx/address ในหน้าเว็บ
EXPLORER_URL=https://www.kubscan.com

# ---------- Chain (service worker — web ไม่เรียก RPC เลย) ----------
# RPC ของ KUB Chain mainnet (มี rate limit — worker จำกัด concurrency + backoff ให้แล้ว)
RPC_URL=https://rpc.kubchain.io
# chain id ต้องเป็น 96 (KUB Mainnet) เท่านั้น — ค่าอื่น worker จะไม่ยอมเริ่มทำงาน
CHAIN_ID=96
# Subgraph สำหรับชื่อ/โลโก้ validator (ไม่บังคับ; ล่มได้แอปยังทำงาน) — เว้นว่าง (SUBGRAPH_URL=) = ปิด
SUBGRAPH_URL=https://gateway.bitkubgraph.io/subgraphs/name/bitkubchain/pos

# ---------- เวลา ----------
# timezone ของ cron (โหมด schedule) และเวลาที่แสดงในหน้าเว็บ (IANA timezone)
APP_TIMEZONE=Asia/Bangkok
# timezone ของ container ทุกตัว (log/เวลาของระบบ) — ปกติตั้งให้ตรงกับ APP_TIMEZONE
TZ=Asia/Bangkok

# ---------- Worker ----------
# ⚠️ worker เซ็นและส่ง transaction จริงบน mainnet เสมอ — ไม่มีโหมดจำลอง
# รอบการทำงานของ worker (วินาที, 5–3600) — หน้าเว็บถือว่า worker "สด" ถ้า tick ภายใน 90 วินาที จึงไม่ควรเกิน 30
TICK_INTERVAL_SEC=30
# จำนวน RPC request พร้อมกันสูงสุด (1–4) — ลดลงถ้าโดน rate limit (-32005) บ่อย
RPC_CONCURRENCY=4
# ระดับ log: fatal | error | warn | info | debug | trace | silent (ดู log: docker compose logs -f worker)
LOG_LEVEL=info

# ---------- ค่าเริ่มต้นของหน้า "ตั้งค่า" (seed ลงฐานข้อมูลครั้งแรกตอน migrate เท่านั้น) ----------
# หลังจากรันครั้งแรกแล้ว แก้ค่าเหล่านี้ที่หน้า settings ในเว็บ (แก้ในไฟล์นี้ภายหลังจะไม่มีผล)
# ช่วงค่าที่รับได้ตรงกับหน้า settings ทุกตัว (ค่าวินาทีทุกตัวไม่เกิน 31536000 = 365 วัน) — ผิดช่วง migrate จะไม่ผ่าน
# KUB ที่กันไว้ในกระเป๋าสำหรับค่า gas เสมอ ไม่ถูก stake (อย่างน้อย 0.05)
GAS_RESERVE_KUB=0.05
# gas price สูงสุด (gwei, 1–1000) ที่ระบบ auto-compound ยอมส่ง tx — สูงกว่านี้ข้ามรอบนั้น (ปกติ KUB ≈ 25 gwei)
MAX_GAS_PRICE_GWEI=50
# ระยะห่างขั้นต่ำระหว่าง auto-compound แต่ละครั้งของ position เดียวกัน (วินาที, อย่างน้อย 3600)
MIN_INTERVAL_SEC=3600
# reward ขั้นต่ำ (KUB) ก่อน compound ในโหมด optimal — ใช้ค่าที่มากกว่าระหว่างค่านี้กับ R* ที่ระบบคำนวณ
R_FLOOR_KUB=0.5
# ระยะเวลาตรวจ position ถี่สุด (วินาที, อย่างน้อย 300) ค่าเริ่มต้น 900 = 15 นาที
CHECK_MIN_SEC=900
# ระยะเวลาตรวจ position ห่างสุด (วินาที, อย่างน้อย 300 และต้อง ≥ CHECK_MIN_SEC) ค่าเริ่มต้น 21600 = 6 ชั่วโมง
CHECK_MAX_SEC=21600
# ซิงก์รายชื่อ validator จาก chain ทุก ๆ (วินาที, อย่างน้อย 300) ค่าเริ่มต้น 1800 = 30 นาที (กด "รีเฟรช" ในเว็บได้ตลอด)
VALIDATOR_SYNC_SEC=1800
