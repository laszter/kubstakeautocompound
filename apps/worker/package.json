{
  "name": "@kubstake/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/worker.ts src/migrate.ts src/healthcheck.ts --bundle --platform=node --target=node26 --format=cjs --outdir=dist --out-extension:.js=.cjs --external:pg-native",
    "dev": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@kubstake/core": "*",
    "@kubstake/db": "*",
    "croner": "11.0.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0"
  }
}
